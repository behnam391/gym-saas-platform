# Server-side URL used by Next.js Server Components and the secure API proxy.
API_BASE_URL=http://localhost:3002/api/v1

# Public WebSocket endpoint used by the browser.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3002/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:3002

# Enables realistic local data and demo accounts when PostgreSQL is unavailable.
DEMO_MODE=false
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=true
