# Copy this file to .env on the server. Never commit the real .env file.

# ===== Public domains =====
DOMAIN=gordyar.ir
API_DOMAIN=api.gordyar.ir

# ===== Secrets (use independent random values of at least 32 characters) =====
POSTGRES_OWNER_PASSWORD=CHANGE_ME_OWNER
POSTGRES_APP_PASSWORD=CHANGE_ME_APP
POSTGRES_ADMIN_PASSWORD=CHANGE_ME_ADMIN
REDIS_PASSWORD=CHANGE_ME_REDIS
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH
JWT_ACCESS_TTL_SECONDS=900
PLATFORM_SECRETS_KEY=CHANGE_ME_TO_BASE64_ENCODED_32_BYTE_KEY

# Optional. Keep blank while the AI provider is unavailable or unconfigured.
ANTHROPIC_API_KEY=

# ===== File storage (S3-compatible, optional for the first release) =====
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=default
S3_PUBLIC_BASE_URL=

# The first release stores uploads on the VPS volume.
LOCAL_UPLOADS_ENABLED=true

# ===== Payment gateway fallback =====
# Prefer managing these credentials from the Super Admin integrations page.
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false
ZARINPAL_CALLBACK_URL=https://app-api.gordyar.ir/api/v1/payments/zarinpal/callback
APP_WEB_ORIGIN=https://app.gordyar.ir

# ===== Notification provider fallback =====
# Keep true until Kavenegar authentication is complete. Before then, put only
# your own verified mobile in the comma-separated allow-list.
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
KAVENEGAR_ALLOWED_RECIPIENTS=
KAVENEGAR_DRY_RUN=true
SMTP_HOST=

# Daily local backup retention. A second off-site copy is still required.
BACKUP_RETENTION_DAYS=7
BACKUP_INTERVAL_SECONDS=86400
