# ===== Secrets — fill via your secrets manager / CI, never commit real values =====
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_ADMIN_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
ANTHROPIC_API_KEY=CHANGE_ME

# ===== File storage (S3-compatible) =====
S3_ENDPOINT=https://storage.example.com
S3_BUCKET=gym-saas-uploads
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_REGION=default

# ===== Notification providers (optional — dry-run logged if unset) =====
SMS_PROVIDER_API_KEY=
SMTP_HOST=

# ===== Public URLs =====
PUBLIC_FRONTEND_URL=https://app.example.com
PUBLIC_API_URL=https://api.example.com
