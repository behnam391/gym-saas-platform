NODE_ENV=development
PORT=3000

# Normal application role (RLS enforced) and platform admin role (BYPASSRLS)
DATABASE_URL=postgresql://gym_app:CHANGE_ME@localhost:5432/gym_saas?schema=public
DATABASE_ADMIN_URL=postgresql://gym_admin:CHANGE_ME@localhost:5432/gym_saas?schema=public

JWT_ACCESS_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_ACCESS_TTL_SECONDS=900
CORS_ORIGIN=http://localhost:3001

REDIS_URL=redis://:CHANGE_ME@localhost:6379
ANTHROPIC_API_KEY=

S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=default

# Optional notification providers; worker uses dry-run mode when absent.
SMS_PROVIDER_API_KEY=
SMTP_HOST=
