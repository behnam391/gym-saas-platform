NODE_ENV=development
PORT=3002

# Normal application role (RLS enforced) and platform admin role (BYPASSRLS)
DATABASE_URL=postgresql://gym_app:gym_local_app@localhost:5432/gym_saas?schema=public
DATABASE_ADMIN_URL=postgresql://gym_admin:gym_local_admin@localhost:5432/gym_saas?schema=public

JWT_ACCESS_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_REFRESH_SECRET=CHANGE_ME_TO_ANOTHER_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_ACCESS_TTL_SECONDS=900
CORS_ORIGIN=http://localhost:3001
PUBLIC_API_ORIGIN=http://localhost:3002
LOCAL_UPLOADS_ENABLED=true

REDIS_URL=redis://localhost:6379
ANTHROPIC_API_KEY=

S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=default

# Optional payment gateway. Gordyar stores prices in toman and converts them
# to rial only at the ZarinPal boundary.
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
ZARINPAL_CALLBACK_URL=http://localhost:3002/api/v1/payments/zarinpal/callback
APP_WEB_ORIGIN=http://localhost:3001

# Kavenegar stays in dry-run until explicitly disabled. While the account is
# restricted, list only the verified test mobile in ALLOWED_RECIPIENTS.
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
KAVENEGAR_ALLOWED_RECIPIENTS=
KAVENEGAR_DRY_RUN=true
SMTP_HOST=
