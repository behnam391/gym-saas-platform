{
  "name": "gordyar-preregistration-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --port 8787",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create gordyar-preregistration",
    "db:migrate:local": "wrangler d1 migrations apply gordyar-preregistration --local",
    "db:migrate:remote": "wrangler d1 migrations apply gordyar-preregistration --remote"
  },
  "devDependencies": {
    "@cloudflare/workerd-windows-64": "^1.20260722.1",
    "@esbuild/win32-x64": "^0.28.1",
    "wrangler": "^4.114.0"
  }
}
