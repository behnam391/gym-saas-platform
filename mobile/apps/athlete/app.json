{
  "expo": {
    "name": "گُردیار",
    "slug": "gordyar-athlete",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gordyar",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ir.gordyar.athlete"
    },
    "android": {
      "package": "ir.gordyar.athlete",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/gordyar-logo.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "backgroundColor": "#07110e",
          "dark": {
            "backgroundColor": "#07110e"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "برای انتخاب عکس پروفایل، گُردیار به تصاویر انتخابی شما دسترسی نیاز دارد.",
          "cameraPermission": "برای ثبت عکس پروفایل، گُردیار به دوربین نیاز دارد."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
