{
  "expo": {
    "name": "گُردیار پرو",
    "slug": "gordyar-pro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gordyarpro",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ir.gordyar.pro"
    },
    "android": {
      "package": "ir.gordyar.pro",
      "adaptiveIcon": {
        "backgroundColor": "#07110E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/gordyar-logo.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "backgroundColor": "#07110E",
          "dark": {
            "backgroundColor": "#07110E"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "برای اسکن گُردیار Pass، اجازه دسترسی به دوربین لازم است.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6674c240-9be4-418f-84da-80157e6bd8e2"
      }
    },
    "owner": "shafie28"
  }
}
